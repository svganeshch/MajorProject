.radial-progress {
    min-width: 26px;
    min-height: 20px;
    --track-color: rgb(80, 80, 80);
    --progress-color: rgb(213, 114, 19);
    --percentage-color: white;
    margin-left: 5px;
    margin-right: 5px;
    margin-top: 5px;
    margin-bottom: 5px;
    width: 100px;
    height: 100px;
}

.radial-progress__label {
    -unity-text-align: middle-left;
    color: var(--percentage-color);
    visibility: hidden;
}
